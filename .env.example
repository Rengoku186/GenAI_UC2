# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# Execution Mode
# Options: 'openai', 'anthropic', 'mock' (mock mode allows full offline testing & deterministic verification)
LLM_PROVIDER=mock

# Config Paths
CONFIG_DIR=configs/
DATA_DIR=data/
OUTPUT_DIR=outputs/

# Environment
LOG_LEVEL=INFO
SANDBOX_TIMEOUT_SECONDS=15
