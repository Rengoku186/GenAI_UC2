       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOANCALC.
       AUTHOR. LEGACY-SYSTEMS-CORP.
      *================================================================*
      * BATCH LOAN INTEREST AND AMORTIZATION CALCULATION PROGRAM
      * CALCULATES MONTHLY INTEREST, TIERED FEES, AND PRINCIPAL DEDUCT
      *================================================================*
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-3090.
       OBJECT-COMPUTER. IBM-3090.
       
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LOAN-INPUT-FILE ASSIGN TO "LOANIN.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT LOAN-REPORT-FILE ASSIGN TO "LOANRPT.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD  LOAN-INPUT-FILE.
       01  LOAN-RECORD.
           05  IN-LOAN-ID          PIC X(10).
           05  IN-CUSTOMER-ID      PIC X(10).
           05  IN-PRINCIPAL-AMT    PIC 9(7)V99.
           05  IN-INTEREST-RATE    PIC 9(2)V999.
           05  IN-TERM-MONTHS      PIC 9(3).
           05  IN-CREDIT-TIER      PIC X(1).

       FD  LOAN-REPORT-FILE.
       01  REPORT-RECORD           PIC X(120).

       WORKING-STORAGE SECTION.
       01  WS-SWITCHES.
           05  WS-EOF-SWITCH       PIC X(1) VALUE 'N'.
               88  END-OF-FILE     VALUE 'Y'.

       01  WS-CALCULATION-VARS.
           05  WS-MONTHLY-RATE     PIC 9(3)V99999 VALUE 0.
           05  WS-MONTHLY-PAYMENT  PIC 9(7)V99 VALUE 0.
           05  WS-MONTHLY-INTEREST PIC 9(7)V99 VALUE 0.
           05  WS-PRINCIPAL-PAID   PIC 9(7)V99 VALUE 0.
           05  WS-TIER-SURCHARGE   PIC 9(5)V99 VALUE 0.
           05  WS-FINAL-BALANCE    PIC 9(7)V99 VALUE 0.
           05  WS-TOTAL-INTEREST   PIC 9(9)V99 VALUE 0.

       01  WS-COUNTERS.
           05  WS-PROCESSED-COUNT  PIC 9(6) VALUE 0.
           05  WS-ERROR-COUNT      PIC 9(6) VALUE 0.

      * COPYBOOK SIMULATION: TIER DEFINITIONS
       COPY TIERDEF.

       PROCEDURE DIVISION.
       0000-MAIN-LOGIC.
           PERFORM 1000-INITIALIZATION
           PERFORM 2000-PROCESS-RECORDS UNTIL END-OF-FILE
           PERFORM 3000-TERMINATION
           STOP RUN.

       1000-INITIALIZATION.
           OPEN INPUT LOAN-INPUT-FILE
           OPEN OUTPUT LOAN-REPORT-FILE
           MOVE 0 TO WS-PROCESSED-COUNT
           MOVE 0 TO WS-ERROR-COUNT
           MOVE 0 TO WS-TOTAL-INTEREST
           READ LOAN-INPUT-FILE
               AT END SET END-OF-FILE TO TRUE
           END-READ.

       2000-PROCESS-RECORDS.
           IF IN-PRINCIPAL-AMT <= 0 OR IN-TERM-MONTHS <= 0
               ADD 1 TO WS-ERROR-COUNT
               PERFORM 2500-LOG-ERROR
           ELSE
               PERFORM 2100-CALCULATE-TIER-SURCHARGE
               PERFORM 2200-CALCULATE-INTEREST
               PERFORM 2300-COMPUTE-AMORTIZATION
               PERFORM 2400-WRITE-REPORT
               ADD 1 TO WS-PROCESSED-COUNT
           END-IF
           READ LOAN-INPUT-FILE
               AT END SET END-OF-FILE TO TRUE
           END-READ.

       2100-CALCULATE-TIER-SURCHARGE.
           EVALUATE IN-CREDIT-TIER
               WHEN 'A'
                   MOVE 0.00 TO WS-TIER-SURCHARGE
               WHEN 'B'
                   COMPUTE WS-TIER-SURCHARGE = IN-PRINCIPAL-AMT * 0.005
               WHEN 'C'
                   COMPUTE WS-TIER-SURCHARGE = IN-PRINCIPAL-AMT * 0.015
               WHEN OTHER
                   COMPUTE WS-TIER-SURCHARGE = IN-PRINCIPAL-AMT * 0.030
           END-EVALUATE.

       2200-CALCULATE-INTEREST.
           COMPUTE WS-MONTHLY-RATE = (IN-INTEREST-RATE / 100.0) / 12.0
           COMPUTE WS-MONTHLY-INTEREST = IN-PRINCIPAL-AMT * WS-MONTHLY-RATE
           ADD WS-MONTHLY-INTEREST TO WS-TOTAL-INTEREST.

       2300-COMPUTE-AMORTIZATION.
           IF WS-MONTHLY-RATE > 0
               COMPUTE WS-MONTHLY-PAYMENT = 
                   (IN-PRINCIPAL-AMT * WS-MONTHLY-RATE) / 
                   (1 - (1 + WS-MONTHLY-RATE) ** (- IN-TERM-MONTHS))
           ELSE
               COMPUTE WS-MONTHLY-PAYMENT = IN-PRINCIPAL-AMT / IN-TERM-MONTHS
           END-IF
           COMPUTE WS-PRINCIPAL-PAID = WS-MONTHLY-PAYMENT - WS-MONTHLY-INTEREST
           COMPUTE WS-FINAL-BALANCE = IN-PRINCIPAL-AMT - WS-PRINCIPAL-PAID + WS-TIER-SURCHARGE.

       2400-WRITE-REPORT.
           STRING IN-LOAN-ID DELIMITED BY SIZE
                  " | " DELIMITED BY SIZE
                  IN-CUSTOMER-ID DELIMITED BY SIZE
                  " | PAYMENT: " DELIMITED BY SIZE
                  WS-MONTHLY-PAYMENT DELIMITED BY SIZE
                  " | BAL: " DELIMITED BY SIZE
                  WS-FINAL-BALANCE DELIMITED BY SIZE
                  INTO REPORT-RECORD
           WRITE REPORT-RECORD.

       2500-LOG-ERROR.
           STRING "ERROR: INVALID RECORD FOR LOAN " DELIMITED BY SIZE
                  IN-LOAN-ID DELIMITED BY SIZE
                  INTO REPORT-RECORD
           WRITE REPORT-RECORD.

       3000-TERMINATION.
           CLOSE LOAN-INPUT-FILE
           CLOSE LOAN-REPORT-FILE
           DISPLAY "PROCESSED RECORDS: " WS-PROCESSED-COUNT
           DISPLAY "ERROR RECORDS:     " WS-ERROR-COUNT
           DISPLAY "TOTAL INTEREST:    " WS-TOTAL-INTEREST.
